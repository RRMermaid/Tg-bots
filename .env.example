# Copy to .env. Never commit actual credentials.
TELEGRAM_BOT_TOKEN=
ADMIN_ID=
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini
# For an OpenAI-compatible gateway, for example Model Gate:
# OPENAI_BASE_URL=https://api.model-gate.com/v1
OPENAI_BASE_URL=
# For Docker Compose: choose a strong private database password.
POSTGRES_PASSWORD=
# For an existing database (without Docker), use a full PostgreSQL URL.
DATABASE_URL=
# Optional separate proxies, used only by the named client.
OPENAI_PROXY_URL=
TELEGRAM_PROXY_URL=
